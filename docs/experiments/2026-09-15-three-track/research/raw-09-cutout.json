- id: '2098924062059979168'
  text: "Here's the prompt - \n\nBuild a single-page hero website called \"Fathom\
    \ — Creative Studio\" using React + Vite (JSX) with Framer Motion for animation.\n\
    Do NOT change or simplify — implement exactly as specified below.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    ASSETS (use these exact URLs, no local files)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    Background plate (warm photographic stage):\n  https://t.co/TbNaXDty1H\n\nSubject\
    \ — bottom layer, plain/unmasked exposure:\n  https://t.co/k8HAz2Hfk3\n\nSubject\
    \ — top layer, masked exposure (stacked pixel-for-pixel over the plain one):\n\
    \  https://t.co/ZgdbRjGWXj\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    FONTS (load from Google Fonts in index.html)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    <link href=\"https://t.co/XN0j9jeNnL\" rel=\"stylesheet\" />\n\n--font-display:\
    \ 'Archivo', 'Helvetica Neue', Arial, sans-serif   (wordmark, headings, buttons)\n\
    --font-body:    'Inter', 'Helvetica Neue', Arial, sans-serif     (everything else)\n\
    \n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nDESIGN TOKENS\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    --amber-050: #ffd9a3\n--amber-100: #ffb35c\n--amber-200: #f2912f\n--amber-300:\
    \ #dc6f22\n--amber-400: #b4501c   (page base)\n--amber-500: #8f3a15\n\n--plum:\
    \      #8a1538   (button fill)\n--plum-hi:   #a81c46   (button hover gradient)\n\
    --plum-ink:  #4d0a1f   (icon-circle fill)\n\n--paper:       #fff6ec   (primary\
    \ text on amber)\n--paper-dim:   rgba(255,246,236,0.8)\n--paper-faint: rgba(255,246,236,0.64)\n\
    --ink:         #2a0f06   (text on light \"solid\" card)\n\n--glass:        rgba(255,246,236,0.14)\n\
    --glass-strong: rgba(255,249,242,0.9)\n--glass-line:   rgba(255,246,236,0.34)\n\
    \n--radius-card: 20px\n--radius-pill: 999px\n--shell-x: clamp(1.15rem, 3.1vw,\
    \ 3.4rem)\n--shell-y: clamp(1.1rem, 2.1vw, 2.1rem)\n\n--ease-out-expo: cubic-bezier(0.16,\
    \ 1, 0.3, 1)\n--ease-out-soft: cubic-bezier(0.22, 0.61, 0.36, 1)\n\nPage <body>:\
    \ background var(--amber-400), color var(--paper), font-family var(--font-body).\n\
    <meta name=\"theme-color\" content=\"#b4501c\" />\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    LAYOUT — FOUR STACKED PLANES (z0 → z3)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    .hero { position:relative; min-height:100svh; overflow:hidden; isolation:isolate;\
    \ }\n\nOne pointer signal (normalised -1→1 on both axes, spring-smoothed) drives\
    \ three\nof the four planes, each moving by a different amount — the differing\
    \ amounts\nare what sell the depth:\n  z0 backdrop  — moves most  (±10 to ±30px\
    \ depending on layer)\n  z1 wordmark  — moves least (±12px / ±8px)\n  z2 subject\
    \   — moves medium (±22px / ±12px)\n  z3 interface shell — fixed, no parallax,\
    \ sits on top and receives all pointer events\n\nusePointerParallax hook (window-level\
    \ listener, fine pointers only):\n  - useMotionValue for rawX/rawY, useSpring(stiffness:55,\
    \ damping:20, mass:0.6) for x/y\n  - rAF-throttled: one pending frame at a time\
    \ via a `frame` ref, never queue more\n  - on pointermove: rawX = (clientX/innerWidth)*2-1,\
    \ rawY = (clientY/innerHeight)*2-1\n  - on pointerleave (document): reset both\
    \ to 0\n  - returns {x, y} as motion values; each consumer does useTransform(x,[-1,1],[depthPx,-depthPx])\n\
    \  - if prefers-reduced-motion: skip the listener entirely, values stay 0\n\n\
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nZ0 — BACKDROP\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    position:absolute, inset:0, z-index:0, aria-hidden.\n\n1. Gradient floor (shows\
    \ until the photo decodes, stays underneath it):\n   radial-gradient(118% 88%\
    \ at 50% 6%, var(--amber-100) 0%, var(--amber-200) 27%,\n     var(--amber-300)\
    \ 55%, var(--amber-400) 82%, var(--amber-500) 100%), var(--amber-400)\n\n2. .backdrop__plate\
    \ — the photographic hero-bg.webp:\n   position:absolute, inset:-3% (scaled past\
    \ the frame so parallax never drags an\n   empty edge into view), background-size:cover,\
    \ background-position:center.\n   Parallax: x = useTransform(px,[-1,1],[14,-14]),\
    \ y = useTransform(py,[-1,1],[10,-10])\n\n3. Three blurred glow orbs (position:absolute,\
    \ border-radius:50%, filter:blur(72px)),\n   each looping opacity+scale forever\
    \ (ease-in-out, alternating):\n   - .glow--warm:  inset:-10% 20% 30% -18%, radial-gradient(circle,\
    \ rgba(255,165,106,0.55), transparent 68%)\n       animate opacity [0.85,1,0.85]\
    \ scale [1,1.08,1], duration 16s\n       parallax x=useTransform(px,[-1,1],[26,-26])\
    \ y=useTransform(py,[-1,1],[18,-18])\n   - .glow--rose:  inset:46% -12% -24% 34%,\
    \ radial-gradient(circle, rgba(255,138,92,0.42), transparent 66%)\n       animate\
    \ opacity [0.65,0.95,0.65] scale [1.04,1,1.04], duration 19s\n       parallax\
    \ x=useTransform(px,[-1,1],[-30,30]) y=useTransform(py,[-1,1],[-16,16])\n   -\
    \ .glow--halo:  inset:4% 26% 40% 26%, radial-gradient(circle, rgba(255,214,158,0.5),\
    \ transparent 62%)\n       animate opacity [0.72,1,0.72] scale [1,1.06,1], duration\
    \ 13s\n       parallax x=useTransform(px,[-1,1],[14,-14]) (y fixed)\n\n4. .backdrop__rim\
    \ — warm light hugging the subject's shoulders:\n   inset:30% 24% -6% 24%, radial-gradient(58%\
    \ 52% at 50% 76%, rgba(255,150,92,0.5), transparent 70%), blur(40px)\n\n5. .backdrop__vignette:\n\
    \   radial-gradient(96% 74% at 50% 46%, transparent 38%, rgba(84,26,6,0.42) 100%),\n\
    \   linear-gradient(180deg, rgba(84,26,6,0.22) 0%, transparent 22%)\n\n6. .backdrop__grain\
    \ — inline SVG feTurbulence noise as a data-URI background-image\n   (baseFrequency:0.85,\
    \ numOctaves:3, saturate 0, opacity 0.55 inside the SVG filter):\n   inset:-50%,\
    \ opacity:0.16, mix-blend-mode:overlay, background-size:180px 180px,\n   pointer-events:none.\
    \ Animate background position x:[0,-12,6,-4,0] y:[0,8,-10,4,0],\n   duration 1.1s,\
    \ linear, repeat infinity — a jittery flicker, not a smooth drift.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    Z1 — GIANT WORDMARK (\"CREATIVE\")\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    It sits between the backdrop and the subject — the subject's cut-out crosses in\n\
    front of it, and that occlusion is what gives the hero its sense of depth. It\n\
    moves the least of the three parallax planes (reads as furthest back).\n\n.wordmark:\
    \ position:absolute, left:0, right:0, top:46%, z-index:1, display:flex,\njustify-content:center,\
    \ pointer-events:none.\nParallax: x=useTransform(px,[-1,1],[12,-12]), y=useTransform(py,[-1,1],[8,-8])\n\
    \n.wordmark__text — text \"CREATIVE\" (single word, uppercase via CSS not literal\
    \ caps):\n  font: var(--font-display) weight 500, font-size:19.6vw (bleeds almost\
    \ edge to\n  edge — the parent .hero clips the overhang), line-height:0.78, letter-spacing:-0.014em\n\
    \  Fill: linear-gradient(104deg, rgba(255,255,255,0.96) 0%, rgba(255,252,247,1)\
    \ 34%,\n    rgba(255,240,221,0.92) 68%, rgba(255,226,196,0.78) 100%), clipped\
    \ to text\n    (background-clip:text, color:transparent)\n  A second mask fades\
    \ the bottom edge: mask-image:linear-gradient(180deg, #000 0%,\n    #000 62%,\
    \ rgba(0,0,0,0.82) 100%)\n\nEntrance (delay = BEAT.word = 0.5s, duration 1.6s,\
    \ ease EASE_EXPO):\n  from {clipPath:'inset(0% 0% 100% 0%)', y:'18%', scale:1.04,\
    \ filter:'blur(14px)'}\n  to   {clipPath:'inset(0% 0% 0% 0%)', y:'0%', scale:1,\
    \ filter:'blur(0px)'}\n  — the word un-masks upward out of a blur, like light\
    \ resolving into focus.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nZ2\
    \ — SUBJECT: TWO-EXPOSURE SPOTLIGHT REVEAL\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    This is the centrepiece interaction. Two photos of the same subject — one plain,\n\
    one wearing a lit tactical mask — are stacked pixel-for-pixel in the same box\n\
    (prepare both source images so their alpha bounding boxes already share one\n\
    canvas size; that registration is what makes the reveal line up). The masked\n\
    exposure sits on top; a radial mask on it punches a circular hole that follows\n\
    the cursor, revealing the plain exposure underneath — reading as a torch/light\n\
    source rather than a cursor-shaped cut-out.\n\nContainer:\n  .subject: position:absolute,\
    \ left:50%, bottom:0, z-index:2, height:97%,\n    transform:translate(-50%,0),\
    \ pointer-events:none\n    Continuous idle float: @keyframes subject-float translate(-50%,0)→translate(-50%,-10px)\n\
    \    →translate(-50%,0), 9s ease-in-out infinite.\n  .subject__inner: parallax\
    \ x=useTransform(px,[-1,1],[-22,22]) y=useTransform(py,[-1,1],[-12,12]),\n   \
    \ entrance from {opacity:0,y:46,scale:1.05} to {opacity:1,y:0,scale:1},\n    duration\
    \ 1.5s delay BEAT.subject=0.28s, ease EASE_EXPO — gated so it only\n    plays\
    \ once BOTH images have fired onLoad (avoid the stack popping in unevenly).\n\
    \  .subject__stack: filter:drop-shadow(0 32px 64px rgba(74,22,4,0.34))\n\nBottom\
    \ image (subject-plain.png): normal flow, height:100%, width:auto,\n  object-fit:contain,\
    \ object-position:bottom center — this sets the box size.\nTop image (subject-masked.png):\
    \ position:absolute, inset:0, same object-fit,\n  with the animated mask-image\
    \ applied (mask-repeat:no-repeat).\n\nSpotlight geometry — SPOT_SIZE=320 (px across),\
    \ SPOT_RADIUS=160, SPOT_CORE=40 (%):\n  mask-image: radial-gradient(circle {radius}px\
    \ at {sx}px {sy}px,\n    transparent 0%, transparent 40%, #000 100%)\n  radius\
    \ is itself a spring-animated motion value: 0 when closed, SPOT_RADIUS (160)\n\
    \  when open — so the hole doesn't just appear, it visibly opens and closes.\n\
    \nuseSpotlight hook (pointer tracking, window-level — the subject sits underneath\n\
    the interface shell, so element-level hover would drop out every time the\npointer\
    \ crossed a card or button; hit-test the container's own rect manually\ninstead):\n\
    \  - three spring-smoothed motion values: x, y (stiffness:260, damping:30, mass:0.4),\n\
    \    open (stiffness:170, damping:26, mass:0.5)\n  - fine-pointer only (matchMedia\
    \ '(pointer: fine)'); no-op otherwise\n  - rAF-throttled pointermove listener\
    \ on window; on each frame, get the\n    container's getBoundingClientRect and\
    \ test whether the event point falls inside it\n  - convert the event point into\
    \ the element's *layout* space (not the raw rect\n    offset) via: localX = (clientX\
    \ - rect.left) * el.offsetWidth / rect.width\n    (same for Y) — necessary because\
    \ the rect reflects the entrance scale/parallax\n    transform, but the mask paints\
    \ in the untransformed box\n  - on first entry (open was 0), jump x/y instantly\
    \ to the entry point (via\n    motionValue.jump) instead of springing from wherever\
    \ the pointer last was —\n    so the hole opens exactly where the cursor is, not\
    \ sliding in from off-stage\n  - set open to 1 while inside the rect, 0 when outside\
    \ or on document pointerleave\n  - if prefers-reduced-motion: skip the spring\
    \ wrapper, return the raw (static) values\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    Z3 — INTERFACE SHELL (fixed, no parallax)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    .shell: position:relative, z-index:3, display:flex, flex-direction:column,\n \
    \ min-height:100svh, padding: var(--shell-y) var(--shell-x) clamp(1.6rem,6vh,4.4rem),\n\
    \  pointer-events:none on itself but pointer-events:auto on every direct child\n\
    \  (so the transparent gaps between UI let pointer events fall through to the\n\
    \  spotlight subject beneath).\n\nStructure top to bottom:\n  1. Navbar\n  2.\
    \ .shell__row--upper — 3-column grid: [Headline] [empty] [StudioIntro, right-aligned]\n\
    \  3. .shell__spacer — flex:1, min-height:clamp(6rem,22vh,16rem), pushes the lower\
    \ row down\n  4. .shell__row--lower — 3-column grid: [StatCards] [empty] [PartnerCard,\
    \ right-aligned]\n\n.shell__row: display:grid, grid-template-columns: minmax(0,1fr)\
    \ minmax(0,0.85fr) minmax(0,1fr),\n  gap:clamp(1rem,3vw,3rem), align-items:start\
    \ (lower row: align-items:end)\n\n── NAVBAR ──\nLogo mark (left): a small abstract\
    \ SVG (30×30, viewBox 0 0 30 30, stroke currentColor\n  width 1.3, two overlapping\
    \ rounded-triangle/leaf paths plus a short vertical stem,\n  second shape at opacity\
    \ 0.8, stem at opacity 0.55) wrapped in an <a href=\"#top\">\n  aria-label \"\
    Fathom — home\". Hover: scale(1.06) rotate(-3deg), transition 0.5s ease-out-expo.\n\
    Nav links (center-right, desktop only ≥900px): Work, Services, About, Contact\
    \ —\n  each with an underline that sweeps in from the right on hover/focus (::after,\n\
    \  scaleX 0→1, transform-origin right→left, 0.55s ease-out-expo).\n\"Lets Connect\"\
    \ pill button (far right, desktop only): see MAGNETIC BUTTON below.\nMobile menu\
    \ toggle (<900px only): 42×42 circle, border 1px var(--glass-line),\n  background\
    \ var(--glass), backdrop-filter blur(10px), simple 3-line hamburger\n  drawn as\
    \ one centered span with box-shadow duplicating a line above and below.\nNav entrance:\
    \ whole bar fades/slides from y:-18→0, duration 0.9s delay BEAT.nav=0.1s;\n  each\
    \ link fades in individually staggered +0.06s apart starting at BEAT.nav+0.08.\n\
    \n── MAGNETIC BUTTON (used for \"Lets Connect\" and \"Read More\") ──\nPill button,\
    \ background var(--plum), box-shadow 0 10px 26px rgba(77,10,31,0.34)\n  inset\
    \ 0 1px 0 rgba(255,255,255,0.14). On hover, a ::before layer with\n  linear-gradient(120deg,\
    \ var(--plum-hi), var(--plum)) fades to opacity 1 (0.5s).\nPhysics: on pointermove\
    \ within the button, compute normalized offset of the\n  cursor from the button's\
    \ own center (dx,dy each in [-1,1], clamped), multiply\n  by a strength constant\
    \ (8px; dy uses 0.6× that), and spring the button's x/y\n  (useSpring, stiffness:220,\
    \ damping:18, mass:0.5) toward that offset — the\n  button visibly leans toward\
    \ the cursor. On pointerleave/blur, spring back to 0,0.\n  Also whileHover scale:1.03,\
    \ whileTap scale:0.97. Skip all of this when\n  prefers-reduced-motion is set.\n\
    \n── LEFT COPY BLOCK (Headline) ──\nHeadline text, broken into exactly these 3\
    \ hand-set lines (never let them\nreflow/rewrap — each is its own overflow:hidden\
    \ clip so the reveal stagers cleanly;\nshrink the font instead of rewrapping on\
    \ narrow screens):\n  \"Give your brand\"\n  \"a system it can\"\n  \"actually\
    \ grow into\"\nStyle: font var(--font-display) weight 400, font-size:clamp(1.32rem,2.16vw,2.15rem),\n\
    \  line-height:1.09, letter-spacing:0.008em, text-transform:uppercase, color var(--paper).\n\
    Each line: <span class=\"line\" style=\"overflow:hidden\"><span class=\"line__inner\"\
    >\n  that slides up from y:112% to y:0% (duration 1.05s, ease EASE_EXPO), staggered\n\
    \  by delay = BEAT.headline(0.32) + i*0.09.\n\nBody copy directly under the headline\
    \ (max-width 34ch, font-size clamp(0.72rem,\n  0.86vw,0.86rem), weight 300, color\
    \ var(--paper-dim), <strong> in var(--paper)\n  weight 600), fades up (opacity\
    \ 0→1, y 22→0, 0.9s) at delay BEAT.headline+0.34:\n  \"From considered Foundations\
    \ to Components your team can trust. And from\n  first principles to production-ready\
    \ detail.\"\n\nBelow that, a small \"Read More\" magnetic-button CTA (btn--sm\
    \ variant, padding\n  0.72rem 1.5rem), fades up at delay BEAT.headline+0.46.\n\
    \n── RIGHT COPY BLOCK (Studio intro) ──\nRight-aligned (text-align:right; on mobile\
    \ <900px becomes left-aligned).\nGiant 2-line heading (font var(--font-display)\
    \ weight 400, font-size:clamp(2.1rem,\n  4.7vw,4.6rem), line-height:0.96, letter-spacing:0.012em,\
    \ uppercase, color paper),\n  same line-clip/slide-up technique as the headline,\
    \ lines exactly:\n  \"Creative\"\n  \"Studio\"\n  staggered delay = https://t.co/IQVsqLMIsX(0.42)\
    \ + i*0.1\n\nBody copy below (max-width 36ch, margin-left:auto so it hugs the\
    \ right edge,\n  same size/weight/color treatment as the left body), fades up\
    \ at BEAT.studio+0.36:\n  \"Fathom is a Creative Studio that treats design systems\
    \ as craft, not\n  infrastructure. We build for teams who want their system to\
    \ feel intentional,\n  not assembled — working from first principles down to the\
    \ smallest interaction.\"\n  (bold the phrases \"Creative Studio\", \"We build\
    \ for teams\", and \"intentional\".)\n\n── STAT CARDS (bottom-left) ──\nRow of\
    \ 2 glass cards, flex, align-items:flex-end, gap:clamp(0.5rem,0.9vw,0.85rem).\n\
    Each: min-width clamp(6rem,8.6vw,8.4rem), padding ~clamp(0.65-0.95rem), border-radius\n\
    \  16px, border 1px var(--glass-line), background var(--glass), backdrop-filter\n\
    \  blur(18px) saturate(1.2), box-shadow 0 18px 40px rgba(74,22,4,0.22). On hover,\n\
    \  lift -6px and deepen the shadow (0.6s ease-out-expo).\nCard 1 (translucent):\
    \ label \"Net Worth\" with a small plum dot bullet before it,\n  value counts\
    \ up from 0 to 15 then appends \"M+\".\nCard 2 (--solid variant: opaque background\
    \ var(--glass-strong), text color var(--ink)\n  instead of paper): label \"Success\
    \ Rate\", value counts up 0→96 then appends \"%\".\nLabel: font-size clamp(0.6rem,0.68vw,0.7rem),\
    \ color paper-dim (or dark on solid card).\nValue: font var(--font-display), font-size\
    \ clamp(1.5rem,2.5vw,2.5rem), color paper\n  (or ink on solid card).\nCount-up:\
    \ animate 0→target over 1.5s, ease [0.16,1,0.3,1], starting at delay\n  https://t.co/sGzO9eefnA(0.9)\
    \ + i*0.1 + 0.25 — render the final number immediately with no\n  animation if\
    \ prefers-reduced-motion.\nCards themselves spring up on entrance: from {opacity:0,y:34,scale:0.97}\
    \ to\n  {opacity:1,y:0,scale:1}, 1s, ease EXPO, delay https://t.co/sGzO9eefnA\
    \ + i*0.1.\n\n── PARTNER CARD (bottom-right) ──\nwidth clamp(13rem,16vw,15.5rem),\
    \ padding ~1rem, border-radius 18px, same glass\n  treatment as the stat cards\
    \ (border var(--glass-line), background var(--glass),\n  blur(18px) saturate(1.2),\
    \ shadow 0 22px 48px rgba(74,22,4,0.24)). Lifts -6px on\n  hover (0.7s ease-out-expo).\
    \ Entrance: cardIn variant, delay BEAT.cards+0.18.\n\nHeader row: 2-line title\
    \ \"Your Partner in / Business Growth\" (font-display weight\n  400, font-size\
    \ clamp(0.86rem,1.02vw,1.02rem), line-height 1.24) on the left, a\n  small circular\
    \ arrow-badge on the right (background var(--plum-ink), a 12×12\n  diagonal-arrow\
    \ SVG stroke currentColor). On card hover, the badge rotates 45deg\n  and its\
    \ background swaps to var(--plum) (0.6s / 0.4s respectively).\n\nBody text below\
    \ (font-size clamp(0.62rem,0.72vw,0.72rem), color paper-faint,\n  hidden entirely\
    \ below 1180px viewport width):\n  \"Systems built to hold up under real product\
    \ pressure — documented, tokenised\n  and handed over ready to ship.\"\n\nFooter\
    \ row: 3 overlapping avatar circles on the left (each ~1.15–1.45rem, border\n\
    \  1.5px rgba(255,246,236,0.85), margin-left -0.42rem so they overlap, first one\n\
    \  has no negative margin) filled with diagonal gradients:\n    linear-gradient(140deg,\
    \ #ffd7a8, #d9743a)\n    linear-gradient(140deg, #f7b3c2, #a81c46)\n    linear-gradient(140deg,\
    \ #ffe2bd, #8f3a15)\n  On card hover, avatars lift -2px. Text to the right: \"\
    5000+\" (bold, its own\n  line) then \"Happy Clients\" beneath, font-size clamp(0.58rem,0.68vw,0.68rem).\n\
    \n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nMOTION SYSTEM\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    One easing vocabulary for the whole page — everything is on the same curve\nfamily\
    \ so the entrance reads as one choreographed move, not many independent ones.\n\
    \  EASE_EXPO = cubic-bezier(0.16, 1, 0.3, 1)\n  EASE_SOFT = cubic-bezier(0.22,\
    \ 0.61, 0.36, 1)\n\nBEAT table (seconds — every component schedules its delay\
    \ off this shared table):\n  nav: 0.1, subject: 0.28, headline: 0.32, studio:\
    \ 0.42, word: 0.5, cards: 0.9\n\nEntrance order on load: nav drops in → headline\
    \ lines slide out of their clips →\nstudio copy slides out → the wordmark unmasks\
    \ upward from a blur → subject rises\ninto place → cards spring up from below\
    \ while their numbers count. After the\nentrance settles, pointer parallax, the\
    \ glow drift loops, and the subject's idle\nfloat keep the scene alive indefinitely.\n\
    \nReusable Framer Motion variants (all take a numeric `delay` via the `custom`\
    \ prop):\n  lineVariants: hidden{y:'112%'} / show{y:'0%', duration:1.05, ease:EXPO}\n\
    \  fadeUp:       hidden{opacity:0,y:22} / show{opacity:1,y:0, duration:0.9, ease:EXPO}\n\
    \  fadeIn:       hidden{opacity:0} / show{opacity:1, duration:1.1, ease:SOFT}\n\
    \  cardIn:       hidden{opacity:0,y:34,scale:0.97} / show{opacity:1,y:0,scale:1,\
    \ duration:1, ease:EXPO}\n\nprefers-reduced-motion: disable the parallax listeners,\
    \ the glow drift and\nsubject float loops, and the spotlight springs (render at\
    \ final/neutral state);\nrender count-up values at their target immediately with\
    \ no animation.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nRESPONSIVE\n\
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nmax-width 1180px:\n  Hide the\
    \ partner card's body paragraph entirely.\n\nmax-width 900px:\n  Hide desktop\
    \ nav links and the \"Lets Connect\" button; show the hamburger toggle.\n  .shell__row\
    \ switches to a single column (grid-template-columns: 1fr), gap\n    clamp(1.6rem,5vw,2.5rem).\n\
    \  Right-aligned blocks (StudioIntro, PartnerCard) become left-aligned/left-justified.\n\
    \  .shell__row--lower switches align-items to start.\n  .shell__spacer shrinks\
    \ to min-height clamp(3.5rem,12vh,8rem).\n  Wordmark anchors to the bottom instead\
    \ of a percentage of height: top:auto,\n    bottom:22% (keeps it in the gap above\
    \ the cards instead of drifting into the\n    copy on short viewports).\n  .subject\
    \ height drops to 60%, opacity 0.9.\n  .partner card width becomes min(20rem,\
    \ 100%).\n\nmax-width 560px:\n  Headline font-size clamp(1rem,5vw,1.9rem); studio\
    \ title clamp(2.2rem,12vw,3.4rem)\n    (the hand-set line breaks never rewrap\
    \ — type shrinks to fit instead).\n  Both body paragraphs drop to font-size 0.78rem.\n\
    \  Wordmark bottom offset becomes 26%; .subject height drops to 52%.\n  Stat cards\
    \ row becomes full-width, each card flex:1 1 0 with min-width:0.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\
    FILE STRUCTURE\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nindex.html   \
    \           — meta description, theme-color #b4501c, Google Fonts link, title\n\
    src/main.jsx             — renders <App /> into #root\nsrc/App.jsx           \
    \   — renders <Hero />\nsrc/components/\n  Hero.jsx                — composes\
    \ Backdrop + WordMark + Subject + shell (Navbar,\n                           \
    \  Headline, StudioIntro, StatCards, PartnerCard)\n  Navbar.jsx              \
    \ — logo mark, nav links, magnetic CTA, mobile toggle\n  Headline.jsx        \
    \     — left copy block (3-line headline, body, Read More CTA)\n  StudioIntro.jsx\
    \          — right copy block (\"Creative Studio\" + body)\n  WordMark.jsx   \
